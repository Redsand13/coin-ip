# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME="Coinpree Signal Engine"
APP_VERSION="1.0.0"
ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-at-least-32-characters-long
API_KEY=your-api-key-at-least-16-chars
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/coinpree
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=60

# ── Binance ───────────────────────────────────────────────────────────────────
BINANCE_BASE_URL=https://fapi.binance.com
BINANCE_WS_URL=wss://fstream.binance.com
BINANCE_API_KEY=
BINANCE_SECRET=
BINANCE_REQUEST_LIMIT=5
BINANCE_RATE_LIMIT_DELAY=0.12

# ── CoinGecko ─────────────────────────────────────────────────────────────────
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=

# ── Scanner ───────────────────────────────────────────────────────────────────
SCANNER_INTERVAL_SECONDS=30
EMA_FAST=7
EMA_MID=25
EMA_SLOW=99
MAX_SYMBOLS_PER_SCAN=300

# ── ML ────────────────────────────────────────────────────────────────────────
ML_MODEL_PATH=models/signal_scorer.joblib
ML_RETRAIN_HOURS=24
ML_MIN_SAMPLES=200

# ── Web Push ──────────────────────────────────────────────────────────────────
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIM_EMAIL=admin@coinpree.com

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console
