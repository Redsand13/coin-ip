# ── FastAPI Backend ───────────────────────────────────────────────────────────
# URL where the Python FastAPI server is running
BACKEND_URL=http://localhost:8000

# Must match API_KEY set in backend/.env
BACKEND_API_KEY=your-api-key-at-least-16-chars

# ── Signal History page password ──────────────────────────────────────────────
SIGNAL_HISTORY_KEY=your-history-page-password

# ── Web Push (optional) ───────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@coinpree.com
